<div class="container">
    <div class="credencial">
        <div class="header">
            <% if (servicio) { %>
                <h5 class="servicio"><%= value(servicio) %></h5>
            <% } %> 
        </div>
        <div class="body">
            <div class="nombre">
                <% if (agente) { %>
                    <h2><%= value(agente.nombre) %> <%= value(agente.apellido) %></h2>
                <% } %>
            </div>
            <div class="break"></div>
            <div class="funcion">
                <% if (funcion) { %>
                    <h3><%=value(funcion) %></h3>
                <% } %>    
            </div>
        </div>
        <div class="footer">
            <img src='<%= srcImgLogoHospital %>' alt="logoHospital">
        </div>
    </div>
</div>