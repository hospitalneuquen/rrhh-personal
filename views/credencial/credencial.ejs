<div class="container">
    <div class="credencial">
        <div class="header">
            <div class="colgante"></div> 
            <div class="contServicio" style="margin-top:<%= value(margenServicio) %>px %>">
                <div class="servicio">
                    <% if (servicio) { %>
                        <h5><%= value(servicio) %></h5>
                    <% } %> 
                </div>
            </div>
        </div>
        <div class="body">
            <div class="contBody">
                <div class="contNombre"  style="margin-top:<%= value(margenNombre) %>px %>"> 
                    <div class="nombre">
                        <% if (agente) { %>
                            <h2><%= value(agente.nombre) %> <%= value(agente.apellido) %></h2>
                        <% } %>
                    </div>
                </div>

                <div class="funcion">
                    <% if (funcion) { %>
                        <h3><%=value(funcion) %></h3>
                     <% } %>    
                </div>

            </div>
        </div>
        <div class="footer">
            <img src='<%= srcImgLogoHospital %>' alt="logoHospital">
        </div>
    </div>
</div>