<!DOCTYPE html>
<html>
    <head>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"> 
    </head>
   <body>
    <%- include("../utils/print") %>
    <% let outerIndex = 0; let hayAgentes = true; %>
    
    <% while (hayAgentes) { %>
        <table>
        <tr>
        <% for (var i = 0; i < 3; i++) { %>
            <% if (agentes.length > outerIndex) { %>
                <td>
                    <%- include('credencial', {agente: agentes[outerIndex], funcion:funciones[outerIndex], servicio:servicios[outerIndex], srcImgLogoHospital:srcImgLogoHospital}) %>
                </td>
            <% } else { %>
                <% hayAgentes = false %>
            <% } %>
            <% outerIndex++ %>
        <% } %>
        </tr>

        <% if (outerIndex % 9 === 0 && hayAgentes) { 
        %>
            </table> 
            <div style="page-break-after: always;"></div> 
        <% } %>
    <% } %>
    <script src="/public/js/script.js"></script>
</body>

</html>