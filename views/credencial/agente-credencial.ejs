<!DOCTYPE html>
<html>
    <head>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"> 
    </head>
    <body>
        <%- include("../utils/print") %>
        <% let outerIndex = 0; let hayAgentes = true; %>
        <table>
        <% while (hayAgentes) { %>
            <% if (outerIndex+1 !=1 && (outerIndex+1) % 9 == 1) { %>
            <% } %>     
            <tr>
            <% for (var i = 0; i < 3; i++) { %>
                <% if (agentes.length > outerIndex) { %>
                    <td>
                        <%- include('credencial', {agente: agentes[outerIndex], funcion:funciones[outerIndex], servicio:servicios[outerIndex], foto:srcImgCredenciales[outerIndex], srcImgLogoHospital:srcImgLogoHospital}) %>            
                    </td>
                <% } else { %>
                    <% hayAgentes = false %>
                <% } %>

                <% outerIndex++ %>
            <% } %> 
            </tr>
        <% } %>
        </table>    
    </body>
</html>